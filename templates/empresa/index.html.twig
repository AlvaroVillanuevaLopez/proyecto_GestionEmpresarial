{% extends 'base.html.twig' %}

{% block title %}Empresa index{% endblock %}

{% block body %}
    <h1>Empresa index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Host</th>
                <th>Puerto</th>
                <th>Usuario</th>
                <th>PasswordEncriptada</th>
                <th>RemotePath</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for empresa in empresas %}
            <tr>
                <td>{{ empresa.id }}</td>
                <td>{{ empresa.nombre }}</td>
                <td>{{ empresa.host }}</td>
                <td>{{ empresa.puerto }}</td>
                <td>{{ empresa.usuario }}</td>
                <td>{{ empresa.passwordEncriptada }}</td>
                <td>{{ empresa.remotePath }}</td>
                <td>
                    <a href="{{ path('app_empresa_show', {'id': empresa.id}) }}">show</a>
                    <a href="{{ path('app_empresa_edit', {'id': empresa.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_empresa_new') }}">Create new</a>
{% endblock %}
