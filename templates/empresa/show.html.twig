{% extends 'base.html.twig' %}

{% block title %}Empresa{% endblock %}

{% block body %}
    <h1>Empresa</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ empresa.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ empresa.nombre }}</td>
            </tr>
            <tr>
                <th>Host</th>
                <td>{{ empresa.host }}</td>
            </tr>
            <tr>
                <th>Puerto</th>
                <td>{{ empresa.puerto }}</td>
            </tr>
            <tr>
                <th>Usuario</th>
                <td>{{ empresa.usuario }}</td>
            </tr>
            <tr>
                <th>PasswordEncriptada</th>
                <td>{{ empresa.passwordEncriptada }}</td>
            </tr>
            <tr>
                <th>RemotePath</th>
                <td>{{ empresa.remotePath }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_empresa_index') }}">back to list</a>

    <a href="{{ path('app_empresa_edit', {'id': empresa.id}) }}">edit</a>

    {{ include('empresa/_delete_form.html.twig') }}
{% endblock %}
